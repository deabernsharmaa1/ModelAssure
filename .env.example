# ModelAssure configuration (all variables use the MA_ prefix). Copy to .env for local overrides.

# Database: the app connects as a NON-owner role so row-level security applies.
MA_DATABASE_URL=postgresql+psycopg://modelassure_app:modelassure_app@localhost:5432/modelassure
MA_MIGRATION_DATABASE_URL=postgresql+psycopg://modelassure:modelassure@localhost:5432/modelassure
MA_ENVIRONMENT=development            # development | test | production

# Identity: dev = local demo logins (never in production); oidc = OAuth2/OIDC identity provider
MA_AUTH_MODE=dev
MA_JWT_SECRET=change-me-dev-only-secret-at-least-32-bytes!
# MA_OIDC_ISSUER=https://login.example.com/
# MA_OIDC_AUDIENCE=modelassure
# MA_OIDC_JWKS_URL=https://login.example.com/.well-known/jwks.json
# MA_REQUIRE_MFA_FOR_PRIVILEGED=true

# Encrypted storage for evidence, reports, datasets and connection secrets
MA_STORAGE_BACKEND=local              # local | s3
MA_STORAGE_PATH=./var/objects
MA_SECRET_STORE_PATH=./var/secrets
# MA_STORAGE_ENCRYPTION_KEY=          # Fernet key; REQUIRED in production. python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# MA_S3_BUCKET=
# MA_S3_ENDPOINT_URL=

# Egress: only these hosts may ever be called (plus each organisation's approved destinations)
MA_ALLOWED_TEST_HOSTS=localhost,127.0.0.1,simulator-baseline,simulator-candidate,dependency-simulator
MA_DEFAULT_CONNECTION_CONCURRENCY=5
MA_MAX_CONNECTION_CONCURRENCY=20

MA_CORS_ORIGINS=http://localhost:3000
MA_WEB_URL=http://localhost:3000
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318   # optional trace export
